    style residual fill:#134d05,stroke:#aaff9e,stroke-width:2px,color:#ffffff,stroke-dasharray: 6 6,rx:12,ry:12;
    style A fill:#324d2e,stroke:#aaff9e,stroke-width:2px,color:#ffffff,stroke-dasharray: 6 6,rx:12,ry:12;
    style finite_difference fill:#05273f,stroke:#00f5db,stroke-width:2px,color:#ffffff,stroke-dasharray: 6 6,rx:12,ry:12;
    style optimization fill:#3a2f2a,stroke:#f78166,stroke-width:2px,color:#ffffff,stroke-dasharray: 6 6,rx:12,ry:12;
    style energy_eigenvalues fill:#0b1c2d,stroke:#14b5ff,stroke-width:2px,color:#ffffff,stroke-dasharray: 6 6,rx:12,ry:12;
    style potential_stencil fill:#0e104b,stroke:#006AFF,stroke-width:4px,color:#ffffff,rx:12,ry:12;
    style eigenfunction_stencil fill:#112131,stroke:#14B5FF,stroke-width:2px,color:#ffffff,rx:12,ry:12;

    classDef stage6 fill:#3a2f2a,stroke:#f78166,stroke-width:2px,color:#ffffff,rx:12,ry:12;   %% diagnostics
    classDef stage7 fill:#3a2f2a,stroke:#f68080,stroke-width:2px,color:#ffffff,rx:12,ry:12;   %% diagnostics
    classDef dashed_orange_1 fill:#161b22,stroke:#f68080,stroke-dasharray:6 6,color:#ffffff,rx:12,ry:12;
    %%-----------------------------------------------------------
    %%  LIGHT‑GRAY ARROW STYLE (so arrows stay subtle)
    %%------------------------------------------------------------
    linkStyle default stroke:#89878d,stroke-width:2px