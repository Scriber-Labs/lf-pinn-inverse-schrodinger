%%====================================================================

flowchart LR

    %%-----------------------------------------------------------
    %%  NODE DEFINITIONS
    %%-----------------------------------------------------------
    step0["0️⃣ Define TISE dynamics."]






    %%-----------------------------------------------------------
    %% CORE PIPELINE (PIML Framework)
    %%--------------------------------------------------------------
    subgraph PIML["PIML Framework"]
    direction LR


        subgraph synthetic["1️⃣ Synthetic Data"]
        direction TB

            spatial_grid["$$x\in[-5,5]$$"]:::spatial
            observed_data["$$\rho_n^\text{obs}, \, E_n^\text{obs} $$"]

        end


        subgraph PINN["2️⃣ MLP"]
        direction LR

            MLP1["MLP"]:::MLP
            MLP2["MLP"]:::MLP
            MLP3["MLP"]:::MLP
            MLP4["MLP"]:::MLP

            potential["$$V_\theta(x)$$"]

            subgraph wavefunctions["Learned Wavefunctions"]
            direction TB

                wavefunction_0["$$\psi_0^\theta$$"]:::wavefunction
                wavefunction_1["$$\psi_1^\theta$$"]:::wavefunction
                wavefunction_final["$$\psi_{n-1}^\theta$$"]:::wavefunction

            end

            %%-----------------------------------------------------------
            %%  Connections
            %%-----------------------------------------------------------
            MLP1 --> potential
            MLP2 --> wavefunction_0
            MLP3 --> wavefunction_1
            MLP4 --> wavefunction_final

        end


    spatial_grid --> MLP1
    spatial_grid --> MLP2
    spatial_grid --> MLP3
    spatial_grid --> MLP4

    end

    %%-----------------------------------------------------------
    %%  External connections
    %%-----------------------------------------------------------
    step0 --> PIML

    %%-----------------------------------------------------------
    %%  STYLE DEFINITIONS (inline, no external CSS)
    %%-----------------------------------------------------------
    style step0 fill:#301934,stroke:#5D3FD3,stroke-width:2px,color:#ffffff,rx:12,ry:12;

    style PIML fill:#0B1C2D,stroke:#14b5ff,stroke-width:1px,color:#ffffff,stroke-dasharray: 6 6,rx:12,ry:12;

    style synthetic fill:#11112ECE,stroke:#5D3FD3,stroke-dasharray:6 6,color:#ffffff,rx:12,ry:12;

    style spatial_grid fill:#1E0026,stroke:#750071,stroke-width:2px,color:#ffffff,rx:12,ry:12;

    style observed_data fill:#1a2a44,stroke:#5280ff,stroke-width:2px,color:#ffffff,rx:12,ry:12;

    classDef wavefunction fill:#224261,stroke:#14B5FF,stroke-width:2px,color:#ffffff,rx:12,ry:12;14B5FF

    style wavefunctions fill:#224261,stroke:#14B5FF,stroke-width:2px,stroke-dasharray:6 6,color:#ffffff,rx:12,ry:12;14B5FF

    style PINN fill:#103b4f,stroke:#00E8FF,stroke-width:2px,color:#ffffff,stroke-dasharray: 6 6,rx:12,ry:12;

    classDef MLP fill:#ddd6ffb7,stroke:#4b28e7,stroke-width:4px,color:#ffffff,rx:12,ry:12;
