%%====================================================================
%%  2️⃣ Project 2 Architecture
%%====================================================================
%%{ init: {
        "theme": "base",
        "themeVariables": {
            "background": "`#0D1117`",
            "lineColor": "`#14B5FF`",
            "fontFamily": "'Aclonica', sans-serif",
            "borderRadius": "16",
        },
        "handDrawn": true,
    }
}%%
%%====================================================================

flowchart TB

    %%-----------------------------------------------------------
    %%  NODE DEFINITIONS
    %%-----------------------------------------------------------
    step0["0️⃣ Define TISE dynamics"]

    %%-----------------------------------------------------------
    %% CORE PIPELINE (PIML Framework)
    %%--------------------------------------------------------------
    subgraph PIML["PIML Framework"]
        direction LR

        subgraph synthetic["1️⃣ Synthetic Data"]
            direction LR
            spatial_grid["$$x\in[-5,5]$$"]:::spatial
            observed_data["$$\rho_n^\text{obs}, \, E_n^\text{obs} $$"]
        end

        subgraph PINN[" "]
            direction TB
            MLP1["MLP"]:::MLP
            MLP2["MLP"]:::MLP
            MLP3["MLP"]:::MLP
            MLP4["MLP"]:::MLP

            potential(("$$V_\theta(x)$$"))
            wavefunction_0(("$$\psi_0^\theta(x)$$")):::eigenfunctions
            wavefunction_1(("$$\psi_1^\theta(x)$$")):::eigenfunctions
            wavefunction_2(("$$\psi_2^\theta(x)$$")):::eigenfunctions


            subgraph potential_network["Potential Network"]
                direction TB

                MLP1 --> potential


            end

            subgraph eigenfunction_networks["Eigenfunction Networks"]
                direction TB
                MLP2 --> wavefunction_0
                MLP3 --> wavefunction_1
                MLP4 --> wavefunction_2
            end

        end

        subgraph energy_eigenvalues["Energy Eigenvalues"]
        direction TB
            energy_0(("$$E_1^\theta$$")):::energy
            energy_1(("$$E_1^\theta$$")):::energy
            energy_2(("$$E_2^\theta$$")):::energy
        end


        spatial_grid --> MLP1
        spatial_grid --> MLP2
        spatial_grid --> MLP3
        spatial_grid --> MLP4


        subgraph loss["4️⃣ Loss Function"]
            direction TB
            loss_tot["$$\mathcal{L}_\text{tot}=\lambda_\text{TISE}\mathcal{L}_\text{TISE}+\lambda_\text{data}\mathcal{L}_\text{data}+\lambda_\text{norm}\mathcal{L}_\text{norm}+\lambda_\text{smooth}\mathcal{L}_\text{smooth}$$"]

            subgraph loss_terms["Loss Terms"]
                direction LR

                loss_physics["$$\mathcal{L}_\text{TISE}=\sum_n^N{\left|\left| -\frac{1}{2}\frac{\partial^2}{\partial x^2}\psi_n^\theta+V_\theta\psi_n^\theta-E_n\psi_n^\theta \right|\right|^2}$$"]
                loss_data["$$\mathcal{L}_\text{data} = \frac{1}N\sum_n^N{\big(E_n^\theta-E_n^\text{obs}\big)^2} + \frac{1}N\sum_n^{N}\frac{1}{M}\sum_j^M{\Big(\left|\psi_n^\theta(x_j)\right|^2-\rho_n^\text{obs}(x_j)\Big)^2}$$"]
                loss_smooth["$$\mathcal{L}_\text{smooth} = \langle \frac{\left|\left| V_\theta''(x)  \right|\right|^2}{\epsilon+\left|\left| V_\theta(x) \right|\right|^2}\rangle$$"]
                loss_norm["$$\mathcal{L}_\text{norm} = \frac{1}{N}\sum_n^N{\bigg( \int{\left|\psi_n^\theta(x) \right|^2dx} - 1 \bigg)^2 }$$"]
            end
            loss_terms:::loss


        end

        subgraph finite_difference["5️⃣ Finite Difference"]
            direction LR
            potential_stencil["$$V_\theta''(x)\,$$ via stencil"]
            eigenfunction_stencil["$$\frac{\partial^2}{\partial x^2}\psi_n^\theta(x) \,$$via stencil"]
        end

        subgraph residual["Physics Residual"]
           A["Physics Residual $$R_n(x)=-\frac{1}{2}\frac{\partial^2}{\partial x^2}\psi^\theta + V_\theta\psi^\theta - E^\theta \psi$$"]
        end
        optimization["Optimizer (Adam)"]

        observed_data --> loss_data

        wavefunction_0 --> eigenfunction_stencil
        wavefunction_1 --> eigenfunction_stencil
        wavefunction_2 --> eigenfunction_stencil

        eigenfunction_stencil --> residual --> loss_physics

        wavefunction_0 --> loss_norm
        wavefunction_1 --> loss_norm
        wavefunction_2 --> loss_norm

        energy_0 --> loss_data
        energy_1 --> loss_data
        energy_2 --> loss_data

        energy_0 --> residual
        energy_1 --> residual
        energy_2 --> residual

        potential --> residual
        potential --> potential_stencil --> loss_smooth

        loss_physics --> loss_tot
        loss_data --> loss_tot
        loss_smooth --> loss_tot
        loss_norm --> loss_tot

        loss_tot --> optimization
        optimization --> MLP1
        optimization --> MLP2
        optimization --> MLP3
        optimization --> MLP4
        optimization --> energy_0
        optimization --> energy_1
        optimization --> energy_2

    end



    %%-----------------------------------------------------------
    %%  External connections
    %%-----------------------------------------------------------
    step0 --> PIML


    %%--------------------------------------------------------------
    %%  POST‑TRAINING DIAGNOSTICS
    %%--------------------------------------------------------------
    sanity_checks["6️⃣ Sanity Checks"]:::stage6

    subgraph POD["7️⃣ POD Diagnostics"]
        direction TB
        SVD["SVD of snapshot matrix"]:::stage6
        sigma["POD spectrum (i.e., singular values)"]:::stage6
        U["POD eigenmodes (columns of U)"]:::stage6
        %% noteW["Wᵀ holds temporal coefficients – not needed for static eigenmode analysis"]:::stage7
        %% noteSpec["‘Spectrum’ = the set of singular values; gaps signal low‑rank structure"]:::stage7

        SVD --> sigma
        SVD --> U
    end
    POD:::dashed_orange_1

    PIML --> sanity_checks
    PIML --> POD

    %%-----------------------------------------------------------
    %%  STYLE DEFINITIONS (inline, no external CSS)
    %%-----------------------------------------------------------
