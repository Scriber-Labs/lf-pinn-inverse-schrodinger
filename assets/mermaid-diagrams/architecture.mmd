    style synthetic fill:#11112E,stroke:#330099,stroke-dasharray:6 6,stroke-width:3px,color:#ffffff,rx:12,ry:12;
    style spatial_grid fill:#1E0026,stroke:#ff3e69,stroke-width:2px,color:#ffffff,rx:12,ry:12;
    style observed_data fill:#231567,stroke:#5280ff,stroke-width:2px,color:#ffffff,rx:12,ry:12;
