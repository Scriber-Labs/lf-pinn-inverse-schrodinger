%%{ init: {
        "theme": "base",
        "themeVariables": {
            "background": "#0D1117",
            "lineColor": "#14B5FF",
            "textColor": "#ffffff",
            "fontFamily": "'Aclonica', sans-serif",
            "borderRadius": "16",
        },
