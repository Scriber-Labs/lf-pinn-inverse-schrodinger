%% ==============================
%% COLOR CLASSES
%% ==============================
classDef data fill:#2ca9e6,stroke:#14B5FF,color:#fff;
classDef model fill:#3C74CC,stroke:#5280FF,color:#fff;
classDef physics fill:#845ccc,stroke:#5E17EB,color:#fff;
classDef operator fill:#309592,stroke:#03E8BD,color:#fff;
classDef loss fill:#FE28A2,stroke:#FF66B3,color:#fff,stroke-dasharray:6 6;
classDef norm fill:#7209b7,stroke:#F72585,color:#fff,stroke-width:2px;
classDef opt fill:#2a1c16,stroke:#FF9D57,color:#fff;
classDef diag fill:#3a2f2a,stroke:#F78166,color:#fff;

%% ==============================
%% DATA (DOMAIN NORMALIZATION)
%% ==============================
subgraph Data["1️⃣ Domain (Input Normalization)"]
    x["$$x\in[-5, 5]$$"]:::data
    dx["$$\Delta x$$"]:::data
end

%% ==============================
%% MODEL
%% ==============================
subgraph Model["2️⃣ Neural Representation"]

    MLP1["MLP"]:::model --> V(("$$V_\theta$$")):::model

    MLP2["MLP"]:::model --> psi_raw0(("$$\psi_0^\theta$$")):::model
    MLP3["MLP"]:::model --> psi_raw1(("$$\psi_1^\theta$$")):::model
    MLP4["MLP"]:::model --> psi_raw2(("$$\psi_2^\theta$$")):::model

end

%% ==============================
%% RANGE CONSTRAINTS (KEY ADDITION)
%% ==============================
subgraph Normalization["3️⃣ Range Constraints"]
    norm1["L2 Normalize\n∫|ψ|² dx = 1"]:::norm
    gs["Gram-Schmidt\n⟨ψi,ψj⟩=0"]:::norm
    eps["+ ε stability"]:::norm
end

%% ==============================
%% FINAL STATES
%% ==============================
psi0(("ψ₀")):::model
psi1(("ψ₁")):::model
psi2(("ψ₂")):::model

%% ==============================
%% OPERATORS
%% ==============================
subgraph Operators["4️⃣ Operators"]
    lap["ψ''"]:::operator
    vdiff["V''"]:::operator
end

%% ==============================
%% PHYSICS
%% ==============================
subgraph Physics["5️⃣ Schrödinger"]
    H["Ĥψ"]:::physics
    R["R(x)"]:::physics
end

%% ==============================
%% LOSS
%% ==============================
subgraph Loss["6️⃣ Loss"]
    Lp["Physics"]:::loss
    Ld["Data"]:::loss
    Ls["Smooth"]:::loss
end

opt["7️⃣ Adam"]:::opt

%% ==============================
%% FLOW
%% ==============================

x --> MLP1
x --> MLP2
x --> MLP3
x --> MLP4

%% normalization pipeline
psi_raw0 --> norm1 --> gs --> eps --> psi0
psi_raw1 --> norm1
psi_raw2 --> norm1

gs --> psi1
gs --> psi2

%% operators
psi0 --> lap
psi1 --> lap
psi2 --> lap

V --> vdiff

%% physics
lap --> H
V --> H

H --> R --> Lp

%% losses
psi0 --> Ld
psi1 --> Ld
psi2 --> Ld

V --> Ls
vdiff --> Ls

%% optimization
Lp --> opt
Ld --> opt
Ls --> opt

opt --> MLP1
opt --> MLP2
opt --> MLP3
opt --> MLP4

%% ==============================
%% POST PROCESSING
%% ==============================
subgraph Post["8️⃣ Alignment & Analysis"]
    phase["Sign / phase alignment"]:::diag
    pod["POD scaling (√Δx)"]:::diag
end

psi0 --> phase
psi1 --> phase
psi2 --> phase

phase --> pod