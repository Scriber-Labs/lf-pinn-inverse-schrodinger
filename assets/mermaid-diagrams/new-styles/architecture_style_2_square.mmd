%% ==============================
%% COLOR CLASSES (SEMANTIC)
%% ==============================
classDef data fill:#2ca9e6,stroke:#14B5FF,color:#ffffff,stroke-width:2px;
classDef model fill:#3C74CC,stroke:#5280FF,color:#ffffff,stroke-width:2px;
classDef physics fill:#845ccc,stroke:#5E17EB,color:#ffffff,stroke-width:2px;
classDef operator fill:#309592,stroke:#03E8BD,color:#ffffff,stroke-width:2px;
classDef loss fill:#FE28A2,stroke:#FF66B3,color:#ffffff,stroke-width:2px,stroke-dasharray:6 6;
classDef opt fill:#2a1c16,stroke:#FF9D57,color:#ffffff,stroke-width:2px;
classDef diag fill:#3a2f2a,stroke:#F78166,color:#ffffff,stroke-width:2px;

%% ==============================
%% DATA
%% ==============================
subgraph Data["1️⃣ Synthetic Data"]
    spatial["Spatial grid x"]:::data
    observed["Observed ρ(x), E"]:::data
end

%% ==============================
%% MODEL
%% ==============================
subgraph Model["2️⃣ Neural Parameterizations"]

    subgraph PotentialNet["Potential Network"]
        MLP1["MLP"]:::model --> V["Vθ(x)"]:::model
    end

    subgraph EigenNet["Eigenfunctions"]
        MLP2["MLP"]:::model --> psi0["ψ₀(x)"]:::model
        MLP3["MLP"]:::model --> psi1["ψ₁(x)"]:::model
        MLP4["MLP"]:::model --> psi2["ψ₂(x)"]:::model
    end

    subgraph Energies["Energy Levels"]
        E0["E₀"]:::model
        E1["E₁"]:::model
        E2["E₂"]:::model
    end

end

%% ==============================
%% OPERATORS
%% ==============================
subgraph Operators["3️⃣ Operators"]
    laplacian["ψ''(x) stencil"]:::operator
    Vdiff["V''(x) stencil"]:::operator
end

%% ==============================
%% PHYSICS
%% ==============================
subgraph Physics["4️⃣ Schrödinger Constraint"]
    H["Ĥψ = -½ψ'' + Vψ"]:::physics
    R["Residual Rₙ(x)"]:::physics
end

%% ==============================
%% LOSS
%% ==============================
subgraph Loss["5️⃣ Total Loss"]
    Lphys["Physics"]:::loss
    Lnorm["Normalization"]:::loss
    Lsmooth["Smoothness"]:::loss
    Ldata["Data"]:::loss
end

%% ==============================
%% OPTIMIZER
%% ==============================
opt["6️⃣ Optimizer (Adam)"]:::opt

%% ==============================
%% FLOW
%% ==============================
spatial --> MLP1
spatial --> MLP2
spatial --> MLP3
spatial --> MLP4

psi0 --> laplacian
psi1 --> laplacian
psi2 --> laplacian

V --> Vdiff

laplacian --> H
V --> H
E0 --> H
E1 --> H
E2 --> H

H --> R

R --> Lphys
psi0 --> Lnorm
psi1 --> Lnorm
psi2 --> Lnorm

V --> Lsmooth
Vdiff --> Lsmooth

psi0 --> Ldata
psi1 --> Ldata
psi2 --> Ldata
observed --> Ldata

Lphys --> opt
Lnorm --> opt
Lsmooth --> opt
Ldata --> opt

opt --> MLP1
opt --> MLP2
opt --> MLP3
opt --> MLP4
opt --> E0
opt --> E1
opt --> E2

%% ==============================
%% DIAGNOSTICS
%% ==============================
subgraph Diagnostics["7️⃣ POD Diagnostics"]
    SVD["SVD"]:::diag
    sigma["Spectrum"]:::diag
    modes["Modes"]:::diag

    SVD --> sigma
    SVD --> modes
end

opt --> Diagnostics