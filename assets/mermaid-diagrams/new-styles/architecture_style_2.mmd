%% ============================== data
%% COLOR CLASSES (your palette)
%% ==============================
classDef data fill:#3881FE,stroke:#5280FF,color:#fff,stroke-width:2px;
classDef loss fill:#845ccc,stroke:#5E17EB,color:#fff,stroke-width:2px;
classDef norm fill:#5f88ff,stroke:#4b54ff,color:#fff,stroke-width:2px;
classDef model fill:#2ca9e6,stroke:#14B5FF,color:#fff,stroke-width:2px;
classDef psiraw fill:#2ca9e6,stroke:#4b54ff,color:#fff,stroke-width:2px,stroke-dasharray:6 6;
classDef operator fill:#038b00,stroke:#31ff48,color:#fff,stroke-width:2px;
classDef physics fill:#309592,stroke:#03E8BD,color:#fff,stroke-width:2px;
classDef opt fill:#FE28A2,stroke:#FF66B3,color:#fff,stroke-width:2px,stroke-dasharray:6 6;
classDef diag fill:#F78166,stroke:#FEB538,color:#fff,stroke-width:2px;


%% ==============================
%% NODES (smaller circles)
%% ==============================
potential(("Vθ")):::model

psi0_raw(["$$\psi_0^\theta \quad$$ (raw)"]):::psiraw
psi1_raw(["$$\psi_1^\theta \quad$$ (raw)"]):::psiraw
psi2_raw(["$$\psi_2^\theta \quad$$ (raw)"]):::psiraw

psi0(("ψ₀")):::model
psi1(("ψ₁")):::model
psi2(("ψ₂")):::model

E0(("E₀")):::model
E1(("E₁")):::model
E2(("E₂")):::model

%% ==============================
%% PIPELINE
%% ==============================
subgraph PIML["PIML Framework"]
direction LR

    subgraph Data["1️⃣ Data"]
        x["x"]:::data
        obs["ρ, E"]:::data
    end

    subgraph Model["2️⃣ Networks"]
        MLP1["MLP"]:::model --> potential
        MLP2["MLP"]:::model --> psi0_raw
        MLP3["MLP"]:::model --> psi1_raw
        MLP4["MLP"]:::model --> psi2_raw
    end

    subgraph Normalization["3️⃣ Range Constraints"]
        norm1["L2 Normalize\n∫|ψ|² dx = 1"]:::norm
        gs["Gram-Schmidt\n⟨ψi,ψj⟩=0"]:::norm
        eps["+ ε stability"]:::norm
    end

    subgraph Operators["3️⃣ Finite differenceOperators"]
        lap["ψ''"]:::operator
        vdiff["V''"]:::operator
    end

    subgraph Physics["4️⃣ Physics"]
        H["Ĥψ"]:::physics
        R["R(x)"]:::physics
    end

    subgraph Loss["5️⃣ Loss"]
        Lp["Physics"]:::loss
        Ln["Norm"]:::loss
        Ls["Smooth"]:::loss
        Ld["Data"]:::loss
    end

    opt["6️⃣ Adam"]:::opt

    %% FLOW
    x --> MLP1
    x --> MLP2
    x --> MLP3
    x --> MLP4

    psi0_raw --> norm1
    psi1_raw --> norm1
    psi2_raw --> norm1

    norm1 --> gs

    gs --> psi0
    gs --> psi1
    gs --> eps

    eps --> psi2

    psi0 --> lap
    psi1 --> lap
    psi2 --> lap

    potential --> vdiff

    lap --> H
    potential --> H
    E0 --> H
    E1 --> H
    E2 --> H

    H --> R --> Lp

    psi0 --> Ln
    psi1 --> Ln
    psi2 --> Ln

    potential --> Ls
    vdiff --> Ls

    psi0 --> Ld
    psi1 --> Ld
    psi2 --> Ld
    obs --> Ld

    Lp --> opt
    Ln --> opt
    Ls --> opt
    Ld --> opt

    opt --> MLP1
    opt --> MLP2
    opt --> MLP3
    opt --> MLP4
    opt --> E0
    opt --> E1
    opt --> E2

end

%% ==============================
%% DIAGNOSTICS
%% ==============================
subgraph diagnostics["Diagnostics"]

    sanity["sanity checks"]:::diag

    subgraph POD["7️⃣ POD"]
        SVD["SVD"]:::diag
        spec["σ"]:::diag
        modes["U"]:::diag

        SVD --> spec
        SVD --> modes
    end

end

psi0 --> diagnostics
psi1 --> diagnostics
psi2 --> diagnostics

E0 --> diagnostics
E1 --> diagnostics
E2 --> diagnostics

potential --> diagnostics

%% ==============================
%% LINKS (subtle)
%% ==============================
linkStyle default stroke:#8b949e,stroke-width:1.5px,opacity:0.8